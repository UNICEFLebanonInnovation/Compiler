# Replication of MSCC data to BMA-NFE (one-way: Compiler -> BMA-NFE)
# DATASYNC_ENABLED must be true for anything to be queued or sent.
DATASYNC_ENABLED=False
DATASYNC_TARGET_URL=https://bma-nfe.example.org/api/sync/events/
DATASYNC_TARGET_TOKEN=
# Optional tuning; the defaults are usually right.
# DATASYNC_TIMEOUT=30
# DATASYNC_BATCH_SIZE=100
# DATASYNC_RETRY_DELAY=60
# DATASYNC_MAX_RETRY_DELAY=3600
# DATASYNC_MAX_ATTEMPTS=12
# DATASYNC_SWEEP_SECONDS=300
# DATASYNC_INLINE_FALLBACK=True
# DATASYNC_VERIFY_TLS=True

DJANGO_OPBEAT_ORGANIZATION_ID
